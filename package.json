{
  "name": "aquaguard-app",
  "version": "1.0.0",
  "description": "AquaGuard: Akıllı Su Kirliliği İzleme, Erken Uyarı ve Karar Destek Platformu",
  "private": true,
  "author": "Meryem Güçlü",
  "license": "MIT",
  "homepage": "https://github.com/meryemgcl/aquaguard-app#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/meryemgcl/aquaguard-app.git"
  },
  "keywords": [
    "water-quality",
    "environmental-monitoring",
    "citizen-science",
    "decision-support",
    "nextjs",
    "leaflet",
    "sqlite",
    "looker-studio"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-check.mjs",
    "test:measurements": "tsx scripts/test-measurements.ts",
    "test:clustering": "tsx scripts/test-clustering.ts",
    "test:open-data": "tsx scripts/test-open-data.ts",
    "test:workflow": "tsx scripts/test-kanban-workflow.ts",
    "test:media": "tsx scripts/test-media-storage.ts",
    "migrate:media": "tsx scripts/migrate-media-to-disk.ts",
    "test": "npm run lint && npm run typecheck && npm run smoke && npm run test:measurements && npm run test:clustering && npm run test:open-data && npm run test:workflow && npm run test:media && npm run build",
    "seed:db": "tsx scripts/seed.ts",
    "clear:db": "tsx scripts/clear-db.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "framer-motion": "^13.0.0",
    "jose": "^6.2.9",
    "leaflet": "^1.9.4",
    "mixpanel-browser": "^2.82.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "supercluster": "^9.0.0",
    "use-supercluster": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mixpanel-browser": "^2.60.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/speakeasy": "^2.0.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
