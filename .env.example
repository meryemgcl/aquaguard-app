# Required for signed local sessions (at least 32 characters).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required together to seed the first local super-admin.
SUPER_ADMIN_EMAIL=admin@example.local
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SUPER_ADMIN_NAME=Local Super Admin

# Optional local SQLite path; defaults to ./data/aquaguard.db.
# AQUAGUARD_DB_PATH=C:\aquaguard\data\aquaguard.db

# Optional integrations.
GEMINI_API_KEY=
RESEND_API_KEY=
MAIL_FROM=
RESEND_TO_OVERRIDE=
APP_URL=http://localhost:3000
ADMIN_EMAIL=
YONETICI_EMAIL=
