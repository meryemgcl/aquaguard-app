rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Draft for the server-only Admin SDK architecture; do not deploy until current
    // client SDK reads/writes have been moved behind authenticated API handlers.
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isSignedIn()
        && request.auth.token.role is string
        && request.auth.token.role in roles;
    }

    function isStaff() {
      return hasRole(['super_admin', 'admin', 'uzman', 'yonetici']);
    }

    // User documents contain password hashes and 2FA secrets; use Admin SDK APIs only.
    match /users/{userId} {
      allow read, write: if false;
    }

    // Report creation and workflow mutations must go through authorized server APIs.
    match /reports/{reportId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /citizen_reports/{reportId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /kanban_cards/{cardId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /approval_history/{recordId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
