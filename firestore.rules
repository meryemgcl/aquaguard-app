rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users Koleksiyonu ──────────────────────────────────────
    // Sunucu taraflı API (Client SDK ile) kullanıcı sorgular
    match /users/{userId} {
      // Login ve register için okuma/oluşturma açık
      allow read: if true;
      allow create: if true;
      // Güncelleme/silme backend üzerinden yapılıyor
      allow update, delete: if false;
    }

    // ── Reports (Kanban Kartları) Koleksiyonu ─────────────────
    match /reports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Vatandaş İhbarları ────────────────────────────────────
    match /citizen_reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ── Kanban Cards Koleksiyonu ──────────────────────────────
    match /kanban_cards/{cardId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Diğer her şey kapalı ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
